# ===========================================
# Mobile App – Environment Variables
# ===========================================
# Copy this file to .env in the mobile-app/ directory.
# Variables prefixed with EXPO_PUBLIC_ are exposed to the Expo runtime.

# ---- Google Maps API Keys ----
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=your_android_google_maps_api_key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=your_ios_google_maps_api_key
# both variables can be the same if you use the same API key for both platforms


